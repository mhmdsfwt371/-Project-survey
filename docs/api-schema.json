      "settings": {"docs": ["goal", "teams", "stock", "devices"], "read": "ok", "write": "mgr"},
      "colist": {"object": "CompanyListEntry", "read": "ok", "write": "mgr", "create_supervisor_condition": "st == 'req'"},
      "events": {"object": "EventDoc", "read": "ok", "create": "canW", "update_delete": "ممنوع على الجميع"},
      "users": {"object": "UserDoc", "read": "صاحب الحساب أو mgr", "write": "admin كامل — engineer ينشئ ويعدّل مشرفين فقط", "delete": "ممنوع"}
    },
    "rules_functions": {
      "isBoss": "request.auth.token.email == 'mohammed.safwat@afaqy.com'",
      "ok": "isBoss أو مستخدم مستنده active == true",
      "role": "admin لو isBoss وإلا من مستند users",
      "mgr": "ok && role in [engineer, admin]",
      "canW": "ok && role in [engineer, admin, supervisor]"
    },
    "rules_deploy": "تعديل firestore.rules في المستودع → deploy-rules.yml ينشرها تلقائيًا — أي كولكشن جديد يستلزم قاعدة يدوية"
  },

